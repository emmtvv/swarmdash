# Copy this to .env and fill in real values (or run `make env` to generate
# random ones). `make deploy` sources it automatically; deploying by hand
# instead, `docker stack deploy` does NOT read .env itself (unlike `docker
# compose`) - export it into your shell first:
#   set -a; . ./.env; set +a; docker stack deploy -c deploy/stack.yml swarmdash
#
# These end up as plain environment variables on the admin/agent/mongo
# services (visible via `docker service inspect` / `docker inspect`), not
# Docker secrets. Don't commit the real .env file - it's gitignored.

# Shared bearer secret authenticating admin -> agent requests. Must be the
# same value the agent and admin services both see.
SWARMDASH_CLUSTER_SECRET=

# Optional: MongoDB root credentials, shared by the bundled mongo service
# and admin's connection string. Defaults to mongo/password (see deploy/
# stack.yml) if left unset - fine as-is since the bundled mongo service is
# never reachable from outside the stack. Override if you'd rather not rely
# on that, e.g. when pointing at an external MongoDB deployment instead.
# SWARMDASH_MONGO_USERNAME=mongo
# SWARMDASH_MONGO_PASSWORD=password

# Optional: bootstrap admin username (defaults to "admin" if unset).
SWARMDASH_ADMIN_USERNAME=

# Optional: pin the bootstrap admin user's password instead of letting
# swarmdash generate one and print it to the admin service's logs. Either
# way, this account is forced to set its own password on first login.
SWARMDASH_ADMIN_PASSWORD=
